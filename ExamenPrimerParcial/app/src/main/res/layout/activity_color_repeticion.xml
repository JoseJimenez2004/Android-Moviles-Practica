<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical" android:padding="16dp"
    android:layout_width="match_parent" android:layout_height="match_parent">

    <TextView android:text="Seleccione color:" android:textSize="18sp"/>
    <Spinner android:id="@+id/spinner_color" android:layout_width="match_parent" android:layout_height="wrap_content"/>

    <TextView android:text="Repeticiones:" android:textSize="18sp" android:layout_marginTop="16dp"/>
    <EditText android:id="@+id/edit_repeticiones" android:inputType="number" android:layout_width="match_parent" android:layout_height="wrap_content"/>

    <Button android:id="@+id/btn_continuar" android:text="Continuar" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp"/>
</LinearLayout>
